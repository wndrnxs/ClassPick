# 모든 값은 선택 사항입니다. 비워 두면 데모 엔진 · SQLite · 테스트 결제로 동작합니다.

# --- AI (Claude 또는 Gemini) ---
ANTHROPIC_API_KEY=
# Google AI Studio(https://aistudio.google.com/apikey)에서 받은 Gemini API 키 — 무료 등급으로 테스트 가능
# Claude 키가 없고 이 키만 있으면 자동으로 Gemini를 씁니다. (무료 등급은 입력 내용이 Google 제품 개선에 쓰일 수 있음)
GEMINI_API_KEY=
CLASSPICK_GEMINI_MODEL=gemini-3.8-flash
# 동시에 보내는 Gemini 요청 수 (무료 등급 분당 요청 제한 대비)
CLASSPICK_GEMINI_CONCURRENCY=2
# auto(키에 따라 자동) / claude / gemini / demo
CLASSPICK_AI_MODE=auto
CLASSPICK_AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLASSPICK_AI_EFFORT=high

# 실제 AI를 쓸 수 있는 계정: members(가입 계정 전체, 기본) | admins(운영자·마스터만)
# 체험(게스트) 계정은 이 값과 관계없이 항상 데모 엔진입니다.
CLASSPICK_AI_USERS=members

# --- 운영자 ---
# 마스터 계정: 가입 없이 환경 변수로만 존재하는 운영·테스트용 선생님 계정 (비밀번호 12자 이상이어야 켜짐)
# 운영자 권한 + 실제 AI 사용 + 로그인할 때마다 토큰 100,000개로 충전
CLASSPICK_MASTER_EMAIL=
CLASSPICK_MASTER_PASSWORD=
# AI 사용량·원가 화면(/app/usage)에 들어갈 수 있는 선생님 계정 이메일 (쉼표로 구분)
CLASSPICK_ADMIN_EMAILS=
# 원가를 원화로 보여 줄 때 쓰는 환율 (원/달러)
CLASSPICK_USD_KRW=1400

# --- Database ---
# 기본: 로컬 SQLite 파일
DATABASE_PATH=./data/classpick.db
# 호스팅 libSQL(Turso 등)을 쓰려면 설정 → 재배포해도 데이터 유지 (설정하면 DATABASE_PATH는 무시)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Payments ---
# mock | toss
PAYMENT_PROVIDER=mock
TOSS_SECRET_KEY=
